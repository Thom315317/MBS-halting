# H6_REPRO_DEPENDENCY_EXTRACTED_DIFF.patch
#
# Minimal v1-task reproducibility-dependency patch for committed
# `dfb99b0`. Documents the exact hunks lifted from the main repo's
# dirty mbs/{graph,datasets}.py without applying the full +52/+1130
# dirty diffs.
#
# This is NOT a `patch -p1`-applicable file. It is a documentation
# of the exact subset extracted. The actual patching is done via
# manual `Edit` calls inside the H7 worktree, so each hunk is
# reviewable.
#
# ============================================================
# (1) mbs/graph.py — 12 LOC across 7 minimal hunks
# ============================================================
#
# Hunk g1 : add MORE_RELIABLE_THAN to EDGE_TYPES (v1 trust chain).
#   AFTER:  "TEMPORAL_NEXT": 11,
#   INSERT: "MORE_RELIABLE_THAN": 12,   # v1 only ; bidirectional trust chain
#
# Hunk g2 : add the mode mapping for MORE_RELIABLE_THAN.
#   AFTER:  EDGE_TYPES["TEMPORAL_NEXT"]: OPERATION_MODES["STABILIZE"],
#   INSERT: EDGE_TYPES["MORE_RELIABLE_THAN"]: OPERATION_MODES["RESOLVE_CONFLICT"],
#
# Hunk g3 : add the two tensor allocations in collate_graph_samples.
#   AFTER:  repair_labels = torch.full((batch_size, max_nodes), -100, dtype=torch.long)
#   INSERT: is_query_claim_node = torch.zeros(batch_size, max_nodes, dtype=torch.bool)
#           claim_value_ids = torch.full((batch_size, max_nodes), -1, dtype=torch.long)
#
# Hunk g4 : read the two new sample-level lists.
#   AFTER:  sample_repair_labels = sample.get("repair_labels")
#   INSERT: sample_is_query_claim_node = sample.get("is_query_claim_node")
#           sample_claim_value_ids = sample.get("claim_value_ids")
#
# Hunk g5 : per-node propagation inside the existing for-loop.
#   AFTER:  if sample_repair_labels is not None and node_idx < len(sample_repair_labels):
#               repair_labels[batch_idx, node_idx] = int(sample_repair_labels[node_idx])
#   INSERT: if sample_is_query_claim_node is not None and node_idx < len(sample_is_query_claim_node):
#               is_query_claim_node[batch_idx, node_idx] = bool(sample_is_query_claim_node[node_idx])
#           if sample_claim_value_ids is not None and node_idx < len(sample_claim_value_ids):
#               claim_value_ids[batch_idx, node_idx] = int(sample_claim_value_ids[node_idx])
#
# Hunk g6 : add the two keys to the returned dict.
#   AFTER:  "repair_labels": repair_labels,
#   INSERT: "is_query_claim_node": is_query_claim_node,
#           "claim_value_ids": claim_value_ids,
#
# Hunk g7 (optional, defensive) : add the two field names to
# `permute_sample_nodes` so node permutation reorders them
# correctly. NOT strictly required by H6 configs but documented in
# dirty main.
#   (Decision : INCLUDED, since the cost is trivial and the
#   correctness guarantee is meaningful when permutation is on.)
#
# DELIBERATELY EXCLUDED from dirty graph.py :
#   * MORE_RELIABLE_THAN_FORWARD (13) and MORE_RELIABLE_THAN_BACKWARD (14)
#     edge types — v2 only.
#   * Their MODE_FOR_EDGE_TYPE entries.
#   * `is_winner_query_claim_node`, `claim_source_is_trusted`,
#     `claim_is_rolled_back` collate tensors — not consumed by
#     `mbs/model.py` nor `mbs/baselines.py` at any point.
#
